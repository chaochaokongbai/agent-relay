{
  "name": "agent-relay",
  "version": "0.1.0",
  "description": "给 AI agent 的 branch protection：接收任意模型/任意客户端的产物，只有过了验证门、留下可复验证据的才准进工作树。零依赖 Node CLI + 零依赖门库（agent-relay/gate）+ 独立复验器（relay recheck）。编排器可换，裁判不必换。",
  "type": "module",
  "main": "lib/gate.mjs",
  "exports": {
    ".": "./lib/gate.mjs",
    "./gate": "./lib/gate.mjs",
    "./bin/relay.mjs": "./bin/relay.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "relay": "bin/relay.mjs"
  },
  "files": [
    "bin",
    "lib",
    "spec",
    "templates",
    "examples",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/run.mjs && node tests/examples-smoke.mjs"
  },
  "keywords": [
    "ai-agent",
    "context",
    "handoff",
    "mcp",
    "multi-agent",
    "llm",
    "beginner"
  ],
  "license": "MIT"
}
